# Notification popups. Catppuccin Mocha neutrals, Claude Code accents —
# see PALETTE.md.
#
# There was no dunstrc at all until now, so notifications rendered in dunst's
# built-in default (white box, black text), which is the one surface on the
# desktop that still broke the theme.
#
# Shape deliberately mirrors waybar/style.css, so a notification reads as
# another chip from the same system rather than as a floating card.
#
# Pixel-art pass (2026-10-09): Departure Mono at 22px (its 11px grid doubled,
# same as the bar, rofi and kitty), square corners, and a 4px frame like the
# bar's and rofi's crust outline. The frame keeps its urgency colour, since
# that colour is what tells a normal notification from an error. Every size
# below is a multiple of 2px so the box sits on the font's pixel grid.

[global]
    # Same monitor as waybar (DP-3, the 4K panel). "mouse" would let popups
    # land on whichever screen the pointer happens to be on, which is worse
    # when one display is a TV.
    follow = none
    monitor = 0

    width = (360, 640)
    height = (0, 400)
    origin = top-right
    # Clears waybar: 58px bar + 8px margin-top + 8px breathing room. The x
    # offset matches the bar's 20px side margin so their right edges line up.
    offset = (20, 74)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 200
    progress_bar_max_width = 640
    progress_bar_corner_radius = 0

    indicate_hidden = yes
    separator_height = 2
    padding = 12
    horizontal_padding = 16
    text_icon_padding = 10
    frame_width = 4
    corner_radius = 0
    gap_size = 6
    separator_color = frame
    sort = yes

    # "px", not points: 11pt would land between grid sizes and blur.
    font = DepartureMono Nerd Font 22px
    line_height = 0
    markup = full
    # The font has one weight, so <b> would make Pango smear a fake bold
    # across the pixel grid. The title stands out in Claude orange instead.
    format = "<span foreground='#d77757'>%s</span>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    enable_recursive_icon_lookup = true
    icon_theme = "Papirus-Dark"
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/firefox
    always_run_script = true

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    frame_color = "#6c7086"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    # mauve slot = Claude autoAccept, the same accent as the Hyprland active
    # border and rofi's selection.
    frame_color = "#af87ff"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    # red slot = Claude error
    frame_color = "#ff6b80"
    timeout = 0

# Screenshot confirmations carry the image as their icon; give them the orange
# frame so they read as "something you did" rather than "something went wrong".
[screenshot]
    appname = notify-send
    summary = "Screenshot saved"
    frame_color = "#d77757"
    timeout = 4
