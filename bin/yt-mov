#!/usr/bin/env bash
# Download a YouTube video and transcode it to a DaVinci-Resolve-friendly
# .mov (DNxHR HQ + PCM audio) in ~/Videos.
#
# Note: yt-dlp's own --recode-video just remuxes when the codec technically
# fits the container, which can produce audio Resolve's decoder rejects even
# though ffmpeg/ffprobe read it fine. Always fully re-encoding avoids that.
#
# Video codec is DNxHR, not H.264: the free/non-Studio build of DaVinci
# Resolve on Linux has no H.264/H.265 decoder (that's licensed and gated to
# Studio there), so an H.264 .mov imports as audio-only with a blank video
# track. DNxHR is an open, unencumbered ffmpeg encoder that free Resolve
# reads natively.
#
# Usage: yt-mov [-s START] [-e END] <url> [more urls...]
#   -s START   clip start, e.g. 1:23 or 00:01:23 (default: beginning)
#   -e END     clip end,   e.g. 4:56 or 00:04:56 (default: end of video)
# Start/end apply to every URL passed. yt-dlp only fetches the requested
# range where the site supports it, rather than the whole video.
set -euo pipefail

out_dir="$HOME/Videos"
mkdir -p "$out_dir"

start=""
end=""
while getopts "s:e:" opt; do
    case "$opt" in
        s) start="$OPTARG" ;;
        e) end="$OPTARG" ;;
        *) echo "Usage: yt-mov [-s START] [-e END] <youtube-url> [more urls...]" >&2; exit 1 ;;
    esac
done
shift "$((OPTIND - 1))"

if [ "$#" -eq 0 ]; then
    echo "Usage: yt-mov [-s START] [-e END] <youtube-url> [more urls...]" >&2
    exit 1
fi

to_seconds() {
    local secs=0 p
    local old_ifs="$IFS"
    IFS=:
    local -a parts=($1)
    IFS="$old_ifs"
    for p in "${parts[@]}"; do
        secs=$((secs * 60 + 10#$p))
    done
    echo "$secs"
}

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

section_args=()
if [ -n "$start" ] || [ -n "$end" ]; then
    start_s=$(to_seconds "${start:-0}")
    for url in "$@"; do
        dur=$(yt-dlp --print duration -- "$url" 2>/dev/null | head -1)
        if [[ "$dur" =~ ^[0-9]+$ ]] && [ "$start_s" -ge "$dur" ]; then
            dur_str=$(yt-dlp --print duration_string -- "$url" 2>/dev/null)
            echo "Error: start time ${start:-0} is at or past the end of $url (video is only ${dur_str})" >&2
            exit 1
        fi
    done
    section_args=(--download-sections "*${start:-0}-${end:-inf}" --force-keyframes-at-cuts)
fi

yt-dlp --merge-output-format mkv "${section_args[@]}" -o "${tmp_dir}/%(title)s.%(ext)s" "$@"

for f in "$tmp_dir"/*; do
    [ -f "$f" ] || continue
    title=$(basename "${f%.*}")
    out="${out_dir}/${title}.mov"
    ffmpeg -y -i "$f" \
        -c:v dnxhd -profile:v dnxhr_hq -pix_fmt yuv422p \
        -c:a pcm_s16le -ar 48000 \
        "$out"
    echo "Saved: $out"
done
