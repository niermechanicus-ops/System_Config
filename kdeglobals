# Catppuccin Mocha (Mauve accent) for Qt/KDE apps — Dolphin, Ark, dialogs.
#
# The [Colors:*] blocks below are NOT redundant with
# color-schemes/CatppuccinMochaMauve.colors. KDE apps read their palette from
# kdeglobals itself; `ColorScheme=` is only a label recording which scheme was
# applied. Applying a scheme (System Settings / plasma-apply-colorscheme)
# copies the .colors sections into this file — without that step the app falls
# back to built-in Breeze defaults, which is why Dolphin's file view rendered
# white while its toolbar and sidebar were dark.
#
# Keep this file and color-schemes/CatppuccinMochaMauve.colors in sync; the
# .colors file is what makes the scheme selectable by name, this is what
# actually paints.
#
# Mocha refs: base #1e1e2e (30,30,46)   mantle #181825 (24,24,37)
#             crust #11111b (17,17,27)  surface0 #313244 (49,50,68)
#             surface1 #45475a (69,71,90)  text #cdd6f4 (205,214,244)
#             subtext0 #a6adc8 (166,173,200)  mauve #cba6f7 (203,166,247)
#             claude-orange #e57e5a  green #a6e3a1  red #f38ba8  yellow #f9e2af

[General]
ColorScheme=CatppuccinMochaMauve
Name=Catppuccin Mocha Mauve
accentActiveTitlebar=false
shadeSortColumn=true
font=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
fixed=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
toolBarFont=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0
menuFont=JetBrainsMono Nerd Font,10,-1,5,50,0,0,0,0,0

[Icons]
Theme=Papirus-Dark

[KDE]
LookAndFeelPackage=org.kde.breezedark.desktop
contrast=4

