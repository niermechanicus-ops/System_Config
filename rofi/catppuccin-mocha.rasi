* {
    bg0:      #1e1e2eee;
    bg1:      #313244;
    fg0:      #cdd6f4;
    fg1:      #a6adc8;
    accent:   #cba6f7;
    urgent:   #f38ba8;

    background-color: transparent;
    text-color:       @fg0;
    font:              "JetBrainsMono Nerd Font 15";
}

window {
    background-color: @bg0;
    /* No border. The accent outline read as a frame around every menu;
     * the translucent bg0 already separates rofi from what's behind it. */
    border:           0;
    border-radius:    12px;
    width:            700px;
    location:         center;
    padding:          16px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing:  12px;
}

inputbar {
    background-color: @bg1;
    border-radius:     8px;
    padding:            10px 12px;
    children:           [ prompt, entry ];
}

prompt {
    text-color: @accent;
    padding:    0 8px 0 0;
}

entry {
    text-color:        @fg0;
    placeholder:        "Search...";
    placeholder-color:  @fg1;
}

listview {
    lines:      8;
    spacing:    4px;
    scrollbar:  false;
}

element {
    padding:        8px 10px;
    border-radius:  8px;
}

element normal.normal {
    text-color: @fg0;
}

element selected.normal {
    background-color: @accent;
    text-color:        @bg0;
}

element-icon {
    size: 22px;
}
