# Set personal aliases, overriding those provided by Oh My Zsh libs,
# plugins, and themes. Aliases can be placed here, though Oh My Zsh
# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension. Examples:
# - $ZSH_CUSTOM/aliases.zsh
# - $ZSH_CUSTOM/macos.zsh
# For a full list of active aliases, run `alias`.
#
# Example aliases
# alias zshconfig="mate ~/.zshrc"
# alias ohmyzsh="mate ~/.oh-my-zsh"

export PATH="$HOME/.local/bin:$PATH"

command -v fastfetch >/dev/null 2>&1 && fastfetch && echo

# ---- fzf + zoxide ----
#
# Sourced BEFORE zsh-syntax-highlighting below, deliberately: both install
# their own ZLE widgets (fzf rebinds ^R / ^T / M-c), and the highlighter works
# by wrapping every widget that exists when *it* is sourced. Anything bound
# after it never gets wrapped, and typing in that widget renders unhighlighted.
#
# Both blocks are guarded on the binary so a fresh clone of this repo still
# gives a working shell before `pacman -S fzf zoxide` has been run.

if command -v fzf >/dev/null 2>&1; then
    # One subprocess, not two: `fzf --zsh` (>= 0.48) emits key-bindings and
    # completion together. The fallback is the older pair of shipped files,
    # for the case where this dotfiles repo lands on an ancient fzf.
    _fzf_init="$(fzf --zsh 2>/dev/null)"
    if [ -n "$_fzf_init" ]; then
        eval "$_fzf_init"
    else
        [ -r /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
        [ -r /usr/share/fzf/completion.zsh ] && source /usr/share/fzf/completion.zsh
    fi
    unset _fzf_init

    # fd rather than find, for ^T and M-c: it honours .gitignore, skips .git,
    # and is already installed. --strip-cwd-prefix drops the leading "./".
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git --strip-cwd-prefix'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git --strip-cwd-prefix'

    # Catppuccin Mocha, same palette as waybar/style.css and kitty.
    export FZF_DEFAULT_OPTS="\
--height 40% --layout=reverse --border=none \
--color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8 \
--color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc \
--color=marker:#b4befe,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8 \
--color=selected-bg:#45475a"
fi

# `z <partial>` jumps to the best-matching directory you've actually visited,
# `zi` picks from a list interactively (which uses fzf, hence the order).
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# ---- completion / suggestion / highlighting plugins ----
#
# Load order below is not arbitrary and should not be shuffled:
#   1. zsh-autocomplete    — rebinds completion keys, wants to come first
#   2. zsh-syntax-highlighting — documented to be sourced near the end
#   3. zsh-autosuggestions — must come *after* syntax highlighting, or the
#      highlighter repaints over the suggestion and it appears to vanish

# zsh-autocomplete is DISABLED on purpose — do not re-enable without reading
# this first.
#
# It was installed but never sourced (so it had never actually run). Sourcing
# it on 2026-08-14 produced the first and only zsh SIGSEGV this machine has
# ever recorded, within a minute, in a real kitty session. The crash stack ran
# zle redrawhook -> zpty -> exit-hook teardown, faulting in unsetparam_pm;
# zpty is exactly what this plugin's async engine uses
# (Functions/Init/.autocomplete__async). Package is 25.03.19 against zsh
# 5.9.2, i.e. well behind.
#
# zsh-autosuggestions below covers most of the same ground and is stable.
#
# To try it again, the targeted mitigation is to disable the async/zpty path
# that crashed, by setting this BEFORE the source line:
#     zstyle ':autocomplete:*' async no
#     source /usr/share/zsh/plugins/zsh-autocomplete/zsh-autocomplete.plugin.zsh
# Untested here — verify with `coredumpctl list` after a day of real use.

# zsh-syntax-highlighting must be sourced near the end of .zshrc
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source "$HOME/.config/zsh/catppuccin_mocha-zsh-syntax-highlighting.zsh"

# Inline ghost-text suggestions from history. overlay0 from the Mocha
# palette — dim enough to read as a suggestion, not as typed input.
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#6c7086'

# Starship prompt — must be last, so nothing sourced above can replace it.
eval "$(starship init zsh)"
